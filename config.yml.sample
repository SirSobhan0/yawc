# Directory containing your wallpaper images (~ tilde expansion is supported)
wallpaper_dir: ~/Pictures/wallpaper

# Command executed to set the selected wallpaper
# Supports the optional ${WALLPAPER} placeholder for explicit path positioning
# Some examples:
# change_command: "dms ipc wallpaper set"
# change_command : "hyprctl hyprpaper wallpaper ', ${WALLPAPER}, cover'"
change_command: "dms ipc wallpaper set"

# Recursively search subdirectories inside wallpaper_dir for image files
search_subdirs: true

# Enable the initial carousel entry animation on launch
extra_animations: true

# How strongly a card's on-screen position drives which part of its photo shows.
# 1.0 = a card at the far-left edge shows the photo's left edge, the centred
# card shows the middle. Values below 1.0 dampen the effect (0 = always
# centre-cropped); above 1.0 saturates it (edges reached sooner).
parallax_strength: 1.0

# Width in pixels of the unselected cards. Smaller values fit more frames on
# screen, which makes the parallax effect much more pronounced.
frame_width: 70

# Width in pixels of the selected (expanded) card
focus_width: 540

# Opacity of the dark backdrop behind the carousel (0.0 - 1.0). Lower values
# show more of the desktop through.
backdrop_opacity: 0.87

# --- Theme ---------------------------------------------------------------
# Card presentation style:
#   slant       - the default. Cards are sheared into parallelograms.
#   perspective - the same slanted cards, plus depth: the row tapers away
#                 toward both screen edges.
theme: slant

# How steeply the row tapers toward the screen edges under the perspective
# theme. 0 = flat (same as slant), 0.45 = moderate, 1.0+ = steep, with the
# outermost cards much shorter. Ignored when theme is slant.
perspective_depth: 0.45

# --- Thumbnail cache -----------------------------------------------------
# Cache small JPEG previews under ~/.cache/yawc/thumbs so subsequent launches
# render instantly instead of decoding every full-size image. Requires the
# python3 Pillow module; silently skipped if unavailable.
thumbnail_cache: true

# Height in pixels of cached thumbnails. Larger looks better while the
# full-resolution image loads, at the cost of disk space and first-run time.
thumbnail_height: 256

# Cache is trimmed (oldest first) once it exceeds this many megabytes.
cache_size_limit_mb: 64
